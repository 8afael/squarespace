<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maria Menarquinha</title>
  {squarespace-headers}
</head>
<body class="hotsite-body">

  <section class="hotsite-hero">
    <div class="hotsite-hero-content">
      <span class="hotsite-badge">Em Breve</span>
      <div class="hotsite-hero-image-wrapper">
        <img src="/assets/menarquinha.jpg" alt="Ilustração Maria Menarquinha" class="hotsite-hero-img" />
      </div>
      <h1 class="hotsite-title">Maria <span>Menarquinha</span></h1>
      <p class="hotsite-subtitle">
        Uma nova jornada sobre corpo, ciclo menstrual, autonomia e educação. Fique por dentro do lançamento oficial.
      </p>

      <form class="hotsite-form" action="#" method="POST" onsubmit="event.preventDefault(); alert('Obrigado pelo interesse!');">
        <input type="email" class="hotsite-input" placeholder="Digite seu melhor e-mail" required />
        <button type="submit" class="hotsite-btn">Quero Acompanhar</button>
      </form>
    </div>
  </section>

  <section class="hotsite-features">
    <div class="hotsite-container">
      <div class="hotsite-grid">
        <div class="hotsite-card">
          <h3>O Projeto</h3>
          <p>Uma iniciativa focada em informação acessível e desmistificação do ciclo menstrual.</p>
        </div>
        <div class="hotsite-card">
          <h3>O Almanaque</h3>
          <p>Conteúdos educativos, ilustrações e materiais exclusivos desenvolvidos para o público jovem.</p>
        </div>
        <div class="hotsite-card">
          <h3>Comunidade</h3>
          <p>Conectando vozes e fortalecendo o diálogo sobre dignidade menstrual e saúde.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Injeção dos blocos dinâmicos do Squarespace (caso queira adicionar blocos no CMS) -->

  <footer class="hotsite-footer">
    <p>&copy; 2026 Girl Up Brasil & Maria Menarca. Todos os direitos reservados.</p>
  </footer>

  {squarespace-footers}
</body>
</html>